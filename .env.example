# Copy to .env and fill in. Empty values fall back to the defaults in docker-compose.yml.

# Auth: JWT signing key (use a long random value in production), session length, HTTPS-only cookie
JWT_SECRET=
JWT_TTL_SECONDS=
COOKIE_SECURE=

# Allowed browser origins, comma-separated
CORS_ORIGINS=

# SLA: minutes until a first staff reply is overdue; worker check interval
SLA_MINUTES=
SLA_POLL_SECONDS=

# Login/signup rate limit per IP
AUTH_RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_WINDOW_MS=

# Only used when running the API outside docker
MONGO_URI=
PORT=
LOG_LEVEL=
