# Optional: docker compose works without a .env file. Copy to .env to override.

# Signing key for session JWTs. Use a long random value outside local demos.
JWT_SECRET=dev-only-secret-change-me-before-deploying
# Session token lifetime (15 minutes). Sessions slide while you are active.
JWT_TTL_SECONDS=900

# Secure cookies default to on when NODE_ENV=production. The compose demo runs
# on plain http://localhost, so it turns them off. Set true behind HTTPS.
COOKIE_SECURE=false

# Comma-separated browser origins allowed by CORS and the Socket.IO handshake.
# (CORS_ORIGIN, singular, is accepted as an alias.)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# SLA: high/urgent tickets without a staff response go overdue after
# SLA_MINUTES (new orgs copy this value). The worker polls every SLA_POLL_SECONDS.
SLA_MINUTES=2
SLA_POLL_SECONDS=10

# Auth endpoints (login/signup): max attempts per IP per window.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Only used when running the API outside docker (npm run dev in /api).
MONGO_URI=mongodb://localhost:27017/sliqdesk?replicaSet=rs0&directConnection=true
PORT=4000
LOG_LEVEL=info
